rules_version = '2';

// Reglas de seguridad — Plataforma Arena Sports (multi-club)
// Pegar completas en Firebase Console → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- quién es quién ----------
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function provider() { return request.auth.token.firebase.sign_in_provider; }
    function staffPath() { return /databases/$(database)/documents/staff/$(myEmail()); }
    function staff() { return get(staffPath()).data; }

    // Es staff si su correo está registrado Y entró con el método con el que se registró
    // (nadie puede crear una cuenta con clave usando el Gmail de alguien que entra con Google).
    function isStaff() {
      return signedIn() && exists(staffPath())
        && (provider() == 'password' || (provider() == 'google.com' && request.auth.token.email_verified == true))
        && (!('modo' in staff()) || staff().modo == provider());
    }
    function isCreador() { return isStaff() && staff().role == 'creador'; }
    function clubDoc(club) { return /databases/$(database)/documents/clubes/$(club); }
    function clubActivo(club) { return exists(clubDoc(club)) && get(clubDoc(club)).data.get('estado', 'activo') != 'suspendido'; }
    function esDelClub(club) { return isStaff() && staff().get('club', '') == club; }
    function isAdminOf(club) { return isCreador() || (esDelClub(club) && staff().role == 'admin' && clubActivo(club)); }
    function isProfeDe(club, cat) { return esDelClub(club) && staff().role == 'profesor' && staff().get('categoria', '') == cat && clubActivo(club); }
    function miClub() { return staff().get('club', '-'); }
    function staffKeysOk() { return request.resource.data.keys().hasOnly(['role', 'club', 'categoria', 'modo']); }

    // ---------- clubes ----------
    match /clubes/{club} {
      // la lista de clubes la ve cualquiera (página de inicio); solo el Creador crea, edita o suspende
      allow read: if true;
      allow write: if isCreador();

      // categorías y perfil predeterminado del club
      match /datos/general {
        allow read: if clubActivo(club) || isCreador();
        allow write: if isAdminOf(club);
      }
      // todo lo privado de una categoría: solo el administrador del club y el profesor de ESA categoría
      match /categorias/{cat} {
        allow read, write: if isAdminOf(club) || isProfeDe(club, cat);
      }
      // lo que muestran las cartas públicas (sin comentarios privados); un club suspendido no se ve
      match /publico/{cat} {
        allow read: if clubActivo(club) || isCreador();
        allow write: if isAdminOf(club) || isProfeDe(club, cat);
      }
      // Puerta de las familias: el código del jugador ES la dirección del documento.
      // Se puede ABRIR si se conoce (get), pero la lista NUNCA se entrega (list), así que
      // nadie puede pedir todos los códigos. El código en claro vive en /categorias, que es privado.
      match /accesos/{codigo} {
        allow get: if clubActivo(club);
        allow list: if false;
        allow write: if isAdminOf(club) || isProfeDe(club, request.resource.data.get('categoria', ''));
        allow delete: if isAdminOf(club) || isProfeDe(club, resource.data.get('categoria', ''));
      }
      // fotos de los jugadores
      match /fotos/{jugador} {
        allow read: if clubActivo(club) || isCreador();
        allow create, update: if (isAdminOf(club) || isProfeDe(club, request.resource.data.get('categoria', '')))
          && request.resource.data.keys().hasOnly(['data', 'categoria', 'actualizada'])
          && request.resource.data.data is string
          && request.resource.data.data.size() < 400000;
        allow delete: if isAdminOf(club) || isProfeDe(club, resource.data.get('categoria', ''));
      }
    }

    // ---------- cuentas del staff ----------
    match /staff/{email} {
      allow read: if isCreador()
        || (signedIn() && email == myEmail())
        || (isStaff() && staff().role == 'admin' && resource.data.get('club', '') == miClub());
      allow create: if staffKeysOk() && (
          (isCreador() && request.resource.data.role in ['creador', 'admin', 'profesor'])
          || (isStaff() && staff().role == 'admin' && clubActivo(miClub())
              && request.resource.data.role in ['admin', 'profesor']
              && request.resource.data.get('club', '') == miClub()));
      allow update: if (staffKeysOk() && isCreador() && request.resource.data.role in ['creador', 'admin', 'profesor'])
        || (staffKeysOk() && isStaff() && staff().role == 'admin' && clubActivo(miClub())
            && resource.data.get('club', '') == miClub()
            && request.resource.data.role in ['admin', 'profesor']
            && request.resource.data.get('club', '') == miClub())
        // cuentas anteriores: cada quien anota una sola vez con qué método entra
        || (signedIn() && email == myEmail() && !('modo' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['modo'])
            && request.resource.data.modo == provider());
      allow delete: if isCreador()
        || (isStaff() && staff().role == 'admin' && resource.data.get('club', '') == miClub());
    }

    // ---------- recordatorios del staff: cada quien maneja los suyos ----------
    match /avisos/{correo} {
      function esMio() { return isStaff() && correo == myEmail(); }
      allow read: if esMio() || isCreador();
      // 'enviados' lo escribe el enviador con permisos de servidor; va en la lista para no romper el guardado del profesor
      allow write: if esMio()
        && request.resource.data.keys().hasOnly(['activo','dias','hora','antes','recordar','horaRecordar','partido','club','categoria','zona','token','actualizado','enviados'])
        && request.resource.data.get('token', '') is string
        && request.resource.data.get('token', '').size() < 500;
    }

    // ---------- estructura anterior (antes de multi-club): solo el Creador, para la migración ----------
    match /club/{doc} { allow read, write: if isCreador(); }
    match /categorias/{cat} { allow read, write: if isCreador(); }
    match /publico/{cat} { allow read, write: if isCreador(); }
    match /fotosJugadores/{f} { allow read, write: if isCreador(); }
    match /appState/{doc} { allow read, write: if isCreador(); }

    // Todo lo demás: cerrado.
  }
}
